generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum AppRole {
  SENDER
  COURIER
  ADMIN
}

enum CourierStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
  DISABLED
}

enum VehicleType {
  WALK
  BIKE
  MOTORCYCLE
  CAR
  /// Taksi ile Gönder — yolcu + kargo eşzamanlı yasak (server enforced).
  TAXI
}

enum TrackingSessionStatus {
  ACTIVE
  ENDED
  REVOKED
}

/// Kurye harita varlık durumu (gönderiden bağımsız presence).
enum CourierActivity {
  AVAILABLE
  ON_JOB
  BUSY
}

enum ShipmentStatus {
  DRAFT
  QUOTED
  PAID
  MATCHED
  PICKED_UP
  IN_TRANSIT
  DELIVERED
  FAILED_DELIVERY
  RETURNED
  CANCELLED
}

model User {
  id        String    @id @db.Uuid
  email     String    @unique
  roles     AppRole[] @default([SENDER])
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  courierProfile    CourierProfile?
  shipmentsSent     Shipment[]      @relation("ShipmentSender")
  shipmentsCourier  Shipment[]      @relation("ShipmentCourier")
  shipmentEvents    ShipmentEvent[]
  wallet            Wallet?
  payouts           Payout[]
  incidentsReported Incident[]      @relation("IncidentReporter")
  incidentsAssigned Incident[]      @relation("IncidentAssignee")
  auditLogs         AuditLog[]
  consents          Consent[]
  trackingSessions  DeliveryTrackingSession[]
  currentLocations  DriverCurrentLocation[]
  locationHistory   DriverLocationHistory[]
  courierPresence   CourierPresence?
  ratingsGiven      Rating[] @relation("RatingFrom")
  ratingsReceived   Rating[] @relation("RatingTo")

  @@map("users")
}

model CourierProfile {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @unique @map("user_id") @db.Uuid
  status          CourierStatus @default(PENDING)
  vehicleType     VehicleType   @map("vehicle_type")
  /// Taksi kargo yeteneği — yalnızca vehicleType=TAXI ve onaylı belgelerle.
  taxiCargoEnabled Boolean      @default(false) @map("taxi_cargo_enabled")
  /// Yolcu taşıyorken kargo kabul edilemez.
  carryingPassenger Boolean     @default(false) @map("carrying_passenger")
  activeZones     String[]      @default([]) @map("active_zones")
  documentPaths   String[]      @default([]) @map("document_paths")
  rejectionReason String?       @map("rejection_reason")
  /// Kamu profilde görünen ad (PII minimizasyonu — tam legal isim değil).
  displayName     String?       @map("display_name")
  ratingAvg       Float         @default(0) @map("rating_avg")
  ratingCount     Int           @default(0) @map("rating_count")
  reviewedAt      DateTime?     @map("reviewed_at")
  reviewedById    String?       @map("reviewed_by_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("courier_profiles")
}

/// Singleton-style platform settings. Rates in basis points (e.g. 1500 = 15%).
model PlatformConfig {
  id                String   @id @default("default")
  commissionBps     Int      @default(1500) @map("commission_bps")
  expressPremiumBps Int      @default(5000) @map("express_premium_bps")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  @@map("platform_config")
}

model Zone {
  id           String   @id @default(uuid()) @db.Uuid
  code         String   @unique
  name         String
  baseFeeMinor Int      @map("base_fee_minor")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  shipments Shipment[]

  @@map("zones")
}

model SizeClass {
  id         String   @id @default(uuid()) @db.Uuid
  code       String   @unique
  name       String
  multiplier Float
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shipments Shipment[]

  @@map("size_classes")
}

model Shipment {
  id             String         @id @default(uuid()) @db.Uuid
  senderId       String         @map("sender_id") @db.Uuid
  courierId      String?        @map("courier_id") @db.Uuid
  status         ShipmentStatus @default(DRAFT)
  zoneId         String         @map("zone_id") @db.Uuid
  sizeClassId    String         @map("size_class_id") @db.Uuid
  isExpress      Boolean        @default(false) @map("is_express")
  /// Taksi ile Gönder hizmeti.
  isTaxiCargo    Boolean        @default(false) @map("is_taxi_cargo")
  pickupAddress  String         @map("pickup_address")
  dropoffAddress String         @map("dropoff_address")
  pickupPlaceId  String?        @map("pickup_place_id")
  dropoffPlaceId String?        @map("dropoff_place_id")
  pickupLat      Float?         @map("pickup_lat")
  pickupLng      Float?         @map("pickup_lng")
  dropoffLat     Float?         @map("dropoff_lat")
  dropoffLng     Float?         @map("dropoff_lng")
  pickupEntranceNote String?    @map("pickup_entrance_note")
  dropoffEntranceNote String?   @map("dropoff_entrance_note")
  recipientName  String         @map("recipient_name")
  recipientPhone String         @map("recipient_phone")
  notes          String?
  /// Kısa sipariş no — örn. YLA-8K2F (public track / UI).
  publicCode     String?        @unique @map("public_code")
  /// Gönderilecek malın cinsi (takip kartı).
  itemDescription String?       @map("item_description")
  itemColor      String?        @map("item_color")
  /// Teslim doğrulama kodunun SHA-256 hash'i — ham kod saklanmaz.
  deliveryCodeHash String?      @map("delivery_code_hash")
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  sender         User            @relation("ShipmentSender", fields: [senderId], references: [id])
  courier        User?           @relation("ShipmentCourier", fields: [courierId], references: [id])
  zone           Zone            @relation(fields: [zoneId], references: [id])
  sizeClass      SizeClass       @relation(fields: [sizeClassId], references: [id])
  deliveryWindow DeliveryWindow?
  priceQuote     PriceQuote?
  events         ShipmentEvent[]
  trackingTokens TrackingToken[]
  ledgerEntries  LedgerEntry[]
  incidents      Incident[]
  trackingSessions DeliveryTrackingSession[]
  currentLocations DriverCurrentLocation[]
  locationHistory  DriverLocationHistory[]
  rating         Rating?

  @@index([senderId])
  @@index([courierId])
  @@index([status])
  @@map("shipments")
}

/// Gönderi başına tek değerlendirme (gönderici → kurye).
model Rating {
  id          String   @id @default(uuid()) @db.Uuid
  shipmentId  String   @unique @map("shipment_id") @db.Uuid
  fromUserId  String   @map("from_user_id") @db.Uuid
  toUserId    String   @map("to_user_id") @db.Uuid
  stars       Int
  tags        String[] @default([])
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  fromUser User     @relation("RatingFrom", fields: [fromUserId], references: [id])
  toUser   User     @relation("RatingTo", fields: [toUserId], references: [id])

  @@index([toUserId, createdAt])
  @@map("ratings")
}

model DeliveryWindow {
  id         String   @id @default(uuid()) @db.Uuid
  shipmentId String   @unique @map("shipment_id") @db.Uuid
  /// Inclusive window start (UTC). Display in Europe/Nicosia.
  startsAt   DateTime @map("starts_at")
  /// Exclusive window end (UTC).
  endsAt     DateTime @map("ends_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("delivery_windows")
}

/// Immutable price snapshot at quote time. Client never supplies these amounts.
model PriceQuote {
  id                  String   @id @default(uuid()) @db.Uuid
  shipmentId          String   @unique @map("shipment_id") @db.Uuid
  amountMinor         Int      @map("amount_minor")
  zoneBaseMinor       Int      @map("zone_base_minor")
  sizeMultiplier      Float    @map("size_multiplier")
  expressPremiumMinor Int      @map("express_premium_minor")
  commissionBps       Int      @map("commission_bps")
  /// Server-side Routes API snapshot (optional until maps enabled).
  routeDistanceMeters Int?     @map("route_distance_meters")
  routeDurationSeconds Int?    @map("route_duration_seconds")
  routePolyline       String?  @map("route_polyline") @db.Text
  routeExpiresAt      DateTime? @map("route_expires_at")
  createdAt           DateTime @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@map("price_quotes")
}

/// Aktif teslimat için konum paylaşım oturumu.
model DeliveryTrackingSession {
  id         String                @id @default(uuid()) @db.Uuid
  shipmentId String                @map("shipment_id") @db.Uuid
  driverId   String                @map("driver_id") @db.Uuid
  status     TrackingSessionStatus @default(ACTIVE)
  startedAt  DateTime              @default(now()) @map("started_at")
  endedAt    DateTime?             @map("ended_at")
  lastLocationAt DateTime?         @map("last_location_at")
  expiresAt  DateTime              @map("expires_at")
  createdAt  DateTime              @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  driver   User     @relation(fields: [driverId], references: [id])

  @@index([shipmentId, status])
  @@index([driverId, status])
  @@map("delivery_tracking_sessions")
}

/// Gönderiden bağımsız kurye varlık satırı — müsait / işte / meşgul harita okuması.
model CourierPresence {
  id              String          @id @default(uuid()) @db.Uuid
  courierUserId   String          @unique @map("courier_user_id") @db.Uuid
  latitude        Float
  longitude       Float
  heading         Float?
  accuracyMeters  Float?          @map("accuracy_meters")
  activity        CourierActivity @default(AVAILABLE)
  sharingEnabled  Boolean         @default(false) @map("sharing_enabled")
  /// Yazım anındaki araç tipi anlık görüntüsü (profil değişse bile marker tutarlı).
  vehicleType     VehicleType     @map("vehicle_type")
  sequenceNumber  Int             @default(0) @map("sequence_number")
  lastSeenAt      DateTime        @map("last_seen_at")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")

  courier User @relation(fields: [courierUserId], references: [id], onDelete: Cascade)

  @@index([sharingEnabled, activity, lastSeenAt])
  @@map("courier_presences")
}

/// Hızlı okuma için son bilinen sürücü konumu (tek satır / gönderi).
model DriverCurrentLocation {
  id                   String   @id @default(uuid()) @db.Uuid
  driverId             String   @map("driver_id") @db.Uuid
  shipmentId           String   @map("shipment_id") @db.Uuid
  latitude             Float
  longitude            Float
  accuracyMeters       Float?   @map("accuracy_meters")
  heading              Float?
  speedMetersPerSecond Float?   @map("speed_mps")
  sequenceNumber       Int      @map("sequence_number")
  deviceTimestamp      DateTime? @map("device_timestamp")
  recordedAt           DateTime @map("recorded_at")
  receivedAt           DateTime @default(now()) @map("received_at")

  driver   User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@unique([shipmentId])
  @@index([driverId])
  @@map("driver_current_locations")
}

/// Operasyonel geçmiş — sınırlı saklama (retention job).
model DriverLocationHistory {
  id                   String   @id @default(uuid()) @db.Uuid
  shipmentId           String   @map("shipment_id") @db.Uuid
  driverId             String   @map("driver_id") @db.Uuid
  latitude             Float
  longitude            Float
  accuracyMeters       Float?   @map("accuracy_meters")
  heading              Float?
  speedMetersPerSecond Float?   @map("speed_mps")
  sequenceNumber       Int      @map("sequence_number")
  recordedAt           DateTime @map("recorded_at")
  receivedAt           DateTime @default(now()) @map("received_at")

  driver   User     @relation(fields: [driverId], references: [id], onDelete: Cascade)
  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId, receivedAt])
  @@index([receivedAt])
  @@map("driver_location_history")
}

model ShipmentEvent {
  id          String          @id @default(uuid()) @db.Uuid
  shipmentId  String          @map("shipment_id") @db.Uuid
  fromStatus  ShipmentStatus? @map("from_status")
  toStatus    ShipmentStatus  @map("to_status")
  actorUserId String?         @map("actor_user_id") @db.Uuid
  createdAt   DateTime        @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorUserId], references: [id])

  @@index([shipmentId, createdAt])
  @@map("shipment_events")
}

/// Paylaşılabilir takip erişimi. Token en az 128-bit rastgele, iptal edilebilir ve süreli.
/// Tahmin edilebilir/sıralı ID kullanılmaz (CLAUDE.md §6.4).
model TrackingToken {
  id         String    @id @default(uuid()) @db.Uuid
  shipmentId String    @map("shipment_id") @db.Uuid
  /// SHA-256 hash of the token. Ham token yalnızca oluşturulurken döner, DB'de saklanmaz.
  tokenHash  String    @unique @map("token_hash")
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  shipment Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)

  @@index([shipmentId])
  @@map("tracking_tokens")
}

enum LedgerEntryType {
  DELIVERY_EARNING
  PLATFORM_COMMISSION
  BONUS
  TIP
  ADJUSTMENT
  REFUND_DEDUCTION
  PAYOUT
  PAYOUT_REVERSAL
}

/// Kazanç yaşam döngüsü. Tutar/tip/referans DEĞİŞMEZ; yalnızca bu durum ilerler.
enum LedgerEntryStatus {
  PENDING
  AVAILABLE
  PAID
}

/// Kurye bakiye hesabı. Bakiye BURADA KOLON DEĞİLDİR —
/// bakiye = SUM(LedgerEntry.amountMinor) (CLAUDE.md §5.2).
model Wallet {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @unique @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user    User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries LedgerEntry[]

  @@map("wallets")
}

/// Değiştirilemez para hareketi satırı. Tutar integer kuruş, işaretli
/// (pozitif = cüzdana alacak, negatif = borç). amountMinor = 0 DB seviyesinde yasak.
model LedgerEntry {
  id             String            @id @default(uuid()) @db.Uuid
  walletId       String            @map("wallet_id") @db.Uuid
  type           LedgerEntryType
  status         LedgerEntryStatus @default(PENDING)
  amountMinor    Int               @map("amount_minor")
  shipmentId     String?           @map("shipment_id") @db.Uuid
  payoutId       String?           @map("payout_id") @db.Uuid
  /// Aynı olayın iki kez yazılmasını engeller (çift ödeme koruması).
  idempotencyKey String            @unique @map("idempotency_key")
  description    String?
  createdAt      DateTime          @default(now()) @map("created_at")
  availableAt    DateTime?         @map("available_at")
  paidAt         DateTime?         @map("paid_at")

  wallet   Wallet    @relation(fields: [walletId], references: [id], onDelete: Cascade)
  shipment Shipment? @relation(fields: [shipmentId], references: [id])
  payout   Payout?   @relation(fields: [payoutId], references: [id])

  @@index([walletId, status])
  @@index([shipmentId])
  @@map("ledger_entries")
}

enum PayoutStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  REVERSED
}

/// Kuryenin parayı bankaya çekmesi. Idempotent — aynı istek iki kez ödeme çıkarmaz.
model Payout {
  id             String       @id @default(uuid()) @db.Uuid
  userId         String       @map("user_id") @db.Uuid
  amountMinor    Int          @map("amount_minor")
  status         PayoutStatus @default(REQUESTED)
  /// Sağlayıcı tarafındaki benzersiz referans.
  reference      String       @unique
  idempotencyKey String       @unique @map("idempotency_key")
  destination    String?
  failureReason  String?      @map("failure_reason")
  requestedAt    DateTime     @default(now()) @map("requested_at")
  processedAt    DateTime?    @map("processed_at")

  user    User          @relation(fields: [userId], references: [id])
  entries LedgerEntry[]

  @@index([userId, status])
  @@map("payouts")
}

enum IncidentType {
  RECIPIENT_UNAVAILABLE
  WRONG_ADDRESS
  PACKAGE_DAMAGED
  PACKAGE_REFUSED
  COURIER_DELAYED
  CANNOT_REACH_SENDER
  CANNOT_REACH_RECIPIENT
  SAFETY_CONCERN
  PAYMENT_ISSUE
  OTHER
}

enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model Incident {
  id           String         @id @default(uuid()) @db.Uuid
  shipmentId   String         @map("shipment_id") @db.Uuid
  reporterId   String         @map("reporter_id") @db.Uuid
  type         IncidentType
  status       IncidentStatus @default(OPEN)
  description  String
  resolution   String?
  assignedToId String?        @map("assigned_to_id") @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  resolvedAt   DateTime?      @map("resolved_at")

  shipment   Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  reporter   User     @relation("IncidentReporter", fields: [reporterId], references: [id])
  assignedTo User?    @relation("IncidentAssignee", fields: [assignedToId], references: [id])

  @@index([status, createdAt])
  @@index([shipmentId])
  @@map("incidents")
}

/// Yetki gerektiren ve geri alınamaz işlemlerin denetim kaydı.
/// Kişisel veri YAZILMAZ — yalnızca kayıt kimlikleri (CLAUDE.md §6.6).
model AuditLog {
  id           String   @id @default(uuid()) @db.Uuid
  actorUserId  String?  @map("actor_user_id") @db.Uuid
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  reason       String?
  metadata     Json?
  createdAt    DateTime @default(now()) @map("created_at")

  actor User? @relation(fields: [actorUserId], references: [id])

  @@index([actorUserId, createdAt])
  @@index([resourceType, resourceId])
  @@map("audit_logs")
}

enum ConsentType {
  TERMS_OF_SERVICE
  PRIVACY_POLICY
  LOCATION_USAGE
  MARKETING_NOTIFICATIONS
  COURIER_DOCUMENT_PROCESSING
}

model Consent {
  id        String      @id @default(uuid()) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  type      ConsentType
  version   String
  granted   Boolean
  createdAt DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type, version])
  @@index([userId])
  @@map("consents")
}

/// Sunucu tarafında zorlanan hız sınırı sayacı. Serverless'ta bellek içi sayaç
/// örnekler arasında paylaşılmadığı için kalıcı depolama kullanılır (CLAUDE.md §6.7).
model RateLimitCounter {
  id          String   @id @default(uuid()) @db.Uuid
  /// "<bucket>:<identifier>" — ör. "auth:203.0.113.4"
  key         String   @unique
  count       Int      @default(0)
  windowStart DateTime @map("window_start")
  expiresAt   DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("rate_limit_counters")
}

/// Operasyonel kill switch / pilot kontrolü. SUNUCUDA zorlanır — client gizlemesi yetki değildir.
model FeatureFlag {
  id          String   @id
  enabled     Boolean  @default(true)
  description String?
  updatedAt   DateTime @updatedAt @map("updated_at")
  updatedById String?  @map("updated_by_id") @db.Uuid

  @@map("feature_flags")
}

/// Tekrarlanan istekleri (gönderi oluşturma, ödeme başlatma) güvenli kılar.
model IdempotencyKey {
  id         String   @id @default(uuid()) @db.Uuid
  key        String   @unique
  userId     String?  @map("user_id") @db.Uuid
  operation  String
  resourceId String?  @map("resource_id")
  createdAt  DateTime @default(now()) @map("created_at")
  expiresAt  DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}
