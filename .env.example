# =============================================================
# YOLLA — ortam değişkenleri (yalnızca ADLAR, gerçek sır YOK)
# Doğrulama: apps/web/src/lib/env.ts — production'da fail-closed.
# =============================================================

# --- Veritabanı -----------------------------------------------
# Runtime (Transaction pooler, port 6543) — Prisma Client kullanır
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migration (Direct/Session) — prisma migrate kullanır
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# --- Kimlik doğrulama (Supabase) ------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"

# Uygulama kodu bunu KULLANMIYOR. Yalnızca yönetim script'i gerekiyorsa ekle;
# aksi halde tanımlama — bulutta gereksiz sır tutma.
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# İlk admini yükseltmek için (yalnızca seed sırasında okunur)
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"

# --- Ödeme sağlayıcı ------------------------------------------
# none = sağlayıcı yok. Bu durumda `payments` bayrağı kapalı tutulmalı;
# uygulama sahte ödemeyi "gerçek" gibi göstermez.
PAYMENTS_PROVIDER="none"
# Sağlayıcı bağlandığında ZORUNLU — imzasız webhook kabul edilmez.
# PAYMENTS_WEBHOOK_SECRET=""

# --- SMS / OTP ------------------------------------------------
# none = gönderim yok. `notifications` ve `phone_auth` bayrakları kapalı kalır.
SMS_PROVIDER="none"
# SMS_API_KEY=""

# --- Harita ---------------------------------------------------
# none = MapCanvas placeholder gösterilir, canlı takip taklidi yapılmaz.
MAPS_PROVIDER="none"
# MAPS_API_KEY=""

# --- Gözlemlenebilirlik ---------------------------------------
# Production'da yoksa uyarı verilir (hata izleme devre dışı).
# SENTRY_DSN=""
