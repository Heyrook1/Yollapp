# =============================================================
# YOLLA — ortam değişkenleri (yalnızca ADLAR, gerçek sır YOK)
# Doğrulama: apps/web/src/lib/env.ts — production'da fail-closed.
# =============================================================

# --- Veritabanı -----------------------------------------------
DATABASE_URL="postgresql://postgres.<project-ref>:[YOUR-PASSWORD]@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@db.<project-ref>.supabase.co:5432/postgres"

# --- Kimlik doğrulama (Supabase) ------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://<project-ref>.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
ADMIN_BOOTSTRAP_EMAIL="admin@example.com"

# --- Yerel demo seed (pnpm db:seed:demo) ----------------------
# Service role varsa Auth kullanıcıları da oluşur; yoksa yalnızca Prisma satırları.
# SEED_DEMO="1"
# DEMO_PASSWORD="YollaDemo123!"

# --- Ödeme sağlayıcı ------------------------------------------
PAYMENTS_PROVIDER="none"
# PAYMENTS_WEBHOOK_SECRET=""

# --- SMS / OTP ------------------------------------------------
SMS_PROVIDER="none"
# SMS_API_KEY=""

# --- Google Maps (ayrı anahtarlar — asla aynı key'i prod'da paylaşma) ---
# Browser: Maps JavaScript API — HTTP referrer kısıtlı
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""
# Server: Routes API + Places API (New) — IP kısıtlı, client'a sızmaz
GOOGLE_MAPS_SERVER_KEY=""
GOOGLE_MAPS_MAP_ID=""
GOOGLE_MAPS_DEFAULT_LAT="35.1856"
GOOGLE_MAPS_DEFAULT_LNG="33.3823"
GOOGLE_MAPS_ROUTES_ENABLED="true"
GOOGLE_MAPS_PLACES_ENABLED="true"
MAPS_PROVIDER="google"
# Eski placeholder anahtar adı (opsiyonel)
# MAPS_API_KEY=""

# --- Gözlemlenebilirlik ---------------------------------------
# SENTRY_DSN=""
